digraph Atividades {
  graph [rankdir=TB, fontname="Helvetica", label="Diagrama de Atividades - Comprar cupcakes (do catálogo ao pedido confirmado)", labelloc=t, fontsize=16, nodesep=0.4, ranksep=0.35];
  node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#FFF0F7", color="#E86AA6"];
  edge [fontname="Helvetica", fontsize=9];
  ini [shape=circle, label="", width=0.25, style=filled, fillcolor=black];
  fim [shape=doublecircle, label="", width=0.2, style=filled, fillcolor=black];
  fim2 [shape=doublecircle, label="", width=0.2, style=filled, fillcolor=black];
  a1 [label="Navegar no catálogo\n(buscar / filtrar categoria)"];
  a2 [label="Adicionar produto ao carrinho"];
  d1 [shape=diamond, label="Estoque\nsuficiente?", fillcolor="#FFFBE6", color="#C9A227"];
  e1 [label="Exibir \"Só temos N unidades\""];
  d2 [shape=diamond, label="Continuar\ncomprando?", fillcolor="#FFFBE6", color="#C9A227"];
  a3 [label="Aplicar cupom (opcional)"];
  d3 [shape=diamond, label="Cupom\nválido?", fillcolor="#FFFBE6", color="#C9A227"];
  e3 [label="Exibir motivo\n(expirado / mínimo / inexistente)"];
  d4 [shape=diamond, label="Usuário\nlogado?", fillcolor="#FFFBE6", color="#C9A227"];
  a4 [label="Login ou cadastro\n(carrinho é preservado)"];
  a5 [label="Escolher entrega ou retirada"];
  d5 [shape=diamond, label="CEP na área\nde entrega?", fillcolor="#FFFBE6", color="#C9A227"];
  e5 [label="Sugerir retirada na loja"];
  a6 [label="Calcular frete e total"];
  a7 [label="Criar pedido (transação):\nbaixa estoque, grava itens,\nstatus AGUARDANDO_PAGAMENTO"];
  d6 [shape=diamond, label="Forma de\npagamento", fillcolor="#FFFBE6", color="#C9A227"];
  a8 [label="Validar cartão (Luhn, validade, CVV)\ne enviar ao gateway"];
  d7 [shape=diamond, label="Aprovado?", fillcolor="#FFFBE6", color="#C9A227"];
  e7 [label="Exibir recusa e permitir\nnova tentativa"];
  a9 [label="Gerar PIX copia e cola"];
  a10 [label="Receber confirmação do PIX"];
  a11 [label="Status CONFIRMADO +\nregistrar histórico"];
  a12 [label="Cliente acompanha o pedido"];
  canc [label="Cliente cancela:\ndevolver estoque"];

  ini -> a1 -> a2 -> d1;
  d1 -> e1 [label="não"]; e1 -> a1;
  d1 -> d2 [label="sim"];
  d2 -> a1 [label="sim"];
  d2 -> a3 [label="não"];
  a3 -> d3; d3 -> e3 [label="não"]; e3 -> d4; d3 -> d4 [label="sim / sem cupom"];
  d4 -> a4 [label="não"]; a4 -> a5; d4 -> a5 [label="sim"];
  a5 -> d5 [label="entrega"]; a5 -> a6 [label="retirada (frete 0)"];
  d5 -> e5 [label="não"]; e5 -> a5;
  d5 -> a6 [label="sim"];
  a6 -> a7 -> d6;
  d6 -> a8 [label="cartão"]; d6 -> a9 [label="PIX"];
  a8 -> d7; d7 -> e7 [label="não"]; e7 -> d6;
  d7 -> a11 [label="sim"];
  a9 -> a10 -> a11 -> a12 -> fim;
  d6 -> canc [label="desiste", style=dashed]; canc -> fim2;
}
