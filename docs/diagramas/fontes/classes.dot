digraph Classes {
  graph [rankdir=TB, splines=ortho, nodesep=0.7, ranksep=0.9, fontname="Helvetica", bgcolor="white", label="Diagrama de Classes (revisado no PIT II) - Sweet Dreams Cupcakes", labelloc=t, fontsize=18];
  node [shape=plain, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, arrowhead=none];
  Usuario [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFF0F7"><tr><td bgcolor="#FF85C0"><b>Usuario</b></td></tr><tr><td align="left">- id: Integer<br align="left"/>- nome: String<br align="left"/>- email: String {unique}<br align="left"/>- senha_hash: String<br align="left"/>- telefone: String<br align="left"/>- tipo: TipoUsuario<br align="left"/>- ativo: Boolean<br align="left"/>- data_cadastro: DateTime<br align="left"/></td></tr><tr><td align="left" bgcolor="#FFE3F0">+ criar(): Integer<br align="left"/>+ autenticar(email, senha): Usuario<br align="left"/>+ atualizarPerfil(nome, tel): void<br align="left"/></td></tr></table>>];
  Endereco [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFF0F7"><tr><td bgcolor="#FF85C0"><b>Endereco</b></td></tr><tr><td align="left">- id: Integer<br align="left"/>- apelido: String<br align="left"/>- cep: String(8)<br align="left"/>- logradouro: String<br align="left"/>- numero: String<br align="left"/>- complemento: String<br align="left"/>- bairro, cidade: String<br align="left"/>- uf: String(2)<br align="left"/>- principal: Boolean<br align="left"/></td></tr><tr><td align="left" bgcolor="#FFE3F0">+ validar(): List&lt;String&gt;<br align="left"/>+ definirPrincipal(): void<br align="left"/>+ formatar(): String<br align="left"/></td></tr></table>>];
  Categoria [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFF0F7"><tr><td bgcolor="#FF85C0"><b>Categoria</b></td></tr><tr><td align="left">- id: Integer<br align="left"/>- nome: String {unique}<br align="left"/>- descricao: String<br align="left"/></td></tr><tr><td align="left" bgcolor="#FFE3F0">+ listar(): List&lt;Categoria&gt;<br align="left"/></td></tr></table>>];
  Produto [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFF0F7"><tr><td bgcolor="#FF85C0"><b>Produto</b></td></tr><tr><td align="left">- id: Integer<br align="left"/>- nome: String<br align="left"/>- descricao: Text<br align="left"/>- preco: Decimal(10,2)<br align="left"/>- estoque: Integer<br align="left"/>- calorias: Integer<br align="left"/>- cor: String<br align="left"/>- destaque: String<br align="left"/>- ativo: Boolean<br align="left"/></td></tr><tr><td align="left" bgcolor="#FFE3F0">+ listar(categoria, busca): List<br align="left"/>+ validar(): List&lt;String&gt;<br align="left"/>+ desativar(): void<br align="left"/></td></tr></table>>];
  Cupom [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFF0F7"><tr><td bgcolor="#FF85C0"><b>Cupom</b></td></tr><tr><td align="left">- id: Integer<br align="left"/>- codigo: String {unique}<br align="left"/>- tipoDesconto: TipoDesconto<br align="left"/>- valorDesconto: Decimal<br align="left"/>- valorMinimoPedido: Decimal<br align="left"/>- dataValidade: Date<br align="left"/>- quantidadeDisponivel: Integer<br align="left"/>- ativo: Boolean<br align="left"/></td></tr><tr><td align="left" bgcolor="#FFE3F0">+ validar(codigo, valor): Cupom<br align="left"/>+ calcularDesconto(valor): Decimal<br align="left"/></td></tr></table>>];
  Pedido [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFF0F7"><tr><td bgcolor="#FF85C0"><b>Pedido</b></td></tr><tr><td align="left">- id: Integer<br align="left"/>- numero: String {unique}<br align="left"/>- tipoEntrega: TipoEntrega<br align="left"/>- enderecoEntrega: String<br align="left"/>- status: StatusPedido<br align="left"/>- valorProdutos: Decimal<br align="left"/>- valorFrete: Decimal<br align="left"/>- valorDesconto: Decimal<br align="left"/>- valorTotal: Decimal<br align="left"/>- observacoes: String<br align="left"/>- dataCriacao: DateTime<br align="left"/></td></tr><tr><td align="left" bgcolor="#FFE3F0">+ criar(cliente, itens, ...): Integer<br align="left"/>+ calcularTotais(): Totais<br align="left"/>+ atualizarStatus(novo): void<br align="left"/>+ atribuirEntregador(id): void<br align="left"/>+ resumoVendas(): Resumo<br align="left"/></td></tr></table>>];
  ItemPedido [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFF0F7"><tr><td bgcolor="#FF85C0"><b>ItemPedido</b></td></tr><tr><td align="left">- id: Integer<br align="left"/>- quantidade: Integer<br align="left"/>- precoUnitario: Decimal<br align="left"/></td></tr><tr><td align="left" bgcolor="#FFE3F0">+ subtotal(): Decimal<br align="left"/></td></tr></table>>];
  Pagamento [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFF0F7"><tr><td bgcolor="#FF85C0"><b>Pagamento</b></td></tr><tr><td align="left">- id: Integer<br align="left"/>- forma: FormaPagamento<br align="left"/>- status: StatusPagamento<br align="left"/>- valor: Decimal<br align="left"/>- cartaoFinal: String(4)<br align="left"/>- bandeira: String<br align="left"/>- codigoTransacao: String<br align="left"/>- pixCopiaCola: String<br align="left"/></td></tr><tr><td align="left" bgcolor="#FFE3F0">+ registrar(): Integer<br align="left"/>+ aprovarPix(): void<br align="left"/></td></tr></table>>];
  Historico [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFF0F7"><tr><td bgcolor="#FF85C0"><b>HistoricoStatus</b></td></tr><tr><td align="left">- id: Integer<br align="left"/>- status: StatusPedido<br align="left"/>- dataHora: DateTime<br align="left"/></td></tr></table>>];
  Enums [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#F4F4F4"><tr><td bgcolor="#DDDDDD"><b>«enumeration»</b></td></tr><tr><td align="left"><b>TipoUsuario</b>: CLIENTE, ADMIN, ENTREGADOR<br align="left"/><b>StatusPedido</b>: AGUARDANDO_PAGAMENTO, CONFIRMADO,<br align="left"/>   EM_PREPARO, SAIU_PARA_ENTREGA, ENTREGUE, CANCELADO<br align="left"/><b>FormaPagamento</b>: CARTAO, PIX<br align="left"/><b>StatusPagamento</b>: PENDENTE, APROVADO, RECUSADO<br align="left"/><b>TipoEntrega</b>: ENTREGA, RETIRADA<br align="left"/><b>TipoDesconto</b>: PERCENTUAL, VALOR_FIXO<br align="left"/></td></tr></table>>];

  {rank=same; Usuario; Pedido; Cupom}
  {rank=same; Endereco; ItemPedido; Pagamento; Historico}
  {rank=same; Categoria; Produto; Enums}

  Usuario -> Endereco [taillabel="1", headlabel="0..*", label=" possui", arrowtail=diamond, dir=back];
  Usuario -> Pedido [taillabel="1", headlabel="0..*", label=" realiza (cliente)"];
  Usuario -> Pedido [taillabel="0..1", headlabel="0..*", label=" entrega (entregador)", style=dashed];
  Pedido -> Cupom [taillabel="0..*", headlabel="0..1", label=" usa"];
  Pedido -> ItemPedido [taillabel="1", headlabel="1..*", label=" contém", arrowtail=diamond, dir=back];
  Pedido -> Pagamento [taillabel="1", headlabel="0..*", label=" é pago por", arrowtail=diamond, dir=back];
  Pedido -> Historico [taillabel="1", headlabel="1..*", label=" registra", arrowtail=diamond, dir=back];
  ItemPedido -> Produto [taillabel="0..*", headlabel="1", label=" referencia"];
  Produto -> Categoria [taillabel="0..*", headlabel="1", label=" pertence a"];
}
